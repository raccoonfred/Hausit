{
  "name": "Door - Double Flush",
  "category": "Doors",
  "description": "Pair of flush doors meeting at the centre. Swings to the interior.",
  "parameters": [
    {
      "name": "Width",
      "type": "Length",
      "default": 1600
    },
    {
      "name": "Height",
      "type": "Length",
      "default": 2040
    },
    {
      "name": "Leaves",
      "type": "Integer",
      "default": 2
    },
    {
      "name": "Frame Width",
      "type": "Length",
      "default": 50
    },
    {
      "name": "Frame Depth",
      "type": "Length",
      "default": 120
    },
    {
      "name": "Leaf Thickness",
      "type": "Length",
      "default": 40
    },
    {
      "name": "Leaf Material",
      "type": "Material",
      "default": "Wood - Oak"
    },
    {
      "name": "Frame Material",
      "type": "Material",
      "default": "Laminate - White"
    }
  ],
  "types": [
    {
      "name": "1500 x 2040mm",
      "values": {
        "Width": 1500
      }
    },
    {
      "name": "1600 x 2040mm",
      "values": {}
    },
    {
      "name": "1800 x 2100mm",
      "values": {
        "Width": 1800,
        "Height": 2100
      }
    }
  ],
  "solids": [
    {
      "shape": "Box",
      "min": [
        "-Width / 2",
        "-min(Wall Thickness, Frame Depth) / 2",
        0
      ],
      "max": [
        "-Width / 2 + Frame Width",
        "min(Wall Thickness, Frame Depth) / 2",
        "Height"
      ],
      "material": "Frame Material"
    },
    {
      "shape": "Box",
      "min": [
        "Width / 2 - Frame Width",
        "-min(Wall Thickness, Frame Depth) / 2",
        0
      ],
      "max": [
        "Width / 2",
        "min(Wall Thickness, Frame Depth) / 2",
        "Height"
      ],
      "material": "Frame Material"
    },
    {
      "shape": "Box",
      "min": [
        "-Width / 2",
        "-min(Wall Thickness, Frame Depth) / 2",
        "Height - Frame Width"
      ],
      "max": [
        "Width / 2",
        "min(Wall Thickness, Frame Depth) / 2",
        "Height"
      ],
      "material": "Frame Material"
    },
    {
      "shape": "Box",
      "min": [
        "-Width / 2 + Frame Width",
        "-Leaf Thickness / 2",
        0
      ],
      "max": [
        -2,
        "Leaf Thickness / 2",
        "Height - Frame Width"
      ],
      "material": "Leaf Material"
    },
    {
      "shape": "Box",
      "min": [
        2,
        "-Leaf Thickness / 2",
        0
      ],
      "max": [
        "Width / 2 - Frame Width",
        "Leaf Thickness / 2",
        "Height - Frame Width"
      ],
      "material": "Leaf Material"
    }
  ],
  "plan": [
    {
      "shape": "Rectangle",
      "min": [
        "-Width / 2",
        "-Wall Thickness / 2"
      ],
      "max": [
        "-Width / 2 + Frame Width",
        "Wall Thickness / 2"
      ]
    },
    {
      "shape": "Rectangle",
      "min": [
        "Width / 2 - Frame Width",
        "-Wall Thickness / 2"
      ],
      "max": [
        "Width / 2",
        "Wall Thickness / 2"
      ]
    },
    {
      "shape": "Rectangle",
      "min": [
        "-Width / 2 + Frame Width",
        "-Wall Thickness / 2 - (Width / 2 - Frame Width)"
      ],
      "max": [
        "-Width / 2 + Frame Width + Leaf Thickness",
        "-Wall Thickness / 2"
      ]
    },
    {
      "shape": "Arc",
      "center": [
        "-Width / 2 + Frame Width",
        "-Wall Thickness / 2"
      ],
      "radius": "(Width / 2 - Frame Width)",
      "start": -90,
      "end": 0
    },
    {
      "shape": "Rectangle",
      "min": [
        "Width / 2 - Frame Width - Leaf Thickness",
        "-Wall Thickness / 2 - (Width / 2 - Frame Width)"
      ],
      "max": [
        "Width / 2 - Frame Width",
        "-Wall Thickness / 2"
      ]
    },
    {
      "shape": "Arc",
      "center": [
        "Width / 2 - Frame Width",
        "-Wall Thickness / 2"
      ],
      "radius": "(Width / 2 - Frame Width)",
      "start": 180,
      "end": 270
    }
  ]
}
