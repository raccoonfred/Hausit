{
  "name": "Wall Cabinet",
  "category": "Casework",
  "description": "Kitchen wall cabinet. Insertion point at the centre of the back; its base sits at the Mounting Height.",
  "parameters": [
    {
      "name": "Width",
      "type": "Length",
      "default": 600
    },
    {
      "name": "Depth",
      "type": "Length",
      "default": 350
    },
    {
      "name": "Height",
      "type": "Length",
      "default": 720
    },
    {
      "name": "Mounting Height",
      "type": "Length",
      "default": 1450
    },
    {
      "name": "Material",
      "type": "Material",
      "default": "Laminate - White"
    }
  ],
  "types": [
    {
      "name": "400mm",
      "values": {
        "Width": 400
      }
    },
    {
      "name": "600mm",
      "values": {}
    },
    {
      "name": "800mm",
      "values": {
        "Width": 800
      }
    }
  ],
  "solids": [
    {
      "shape": "Box",
      "min": [
        "-Width / 2",
        "-Depth + 20",
        "Mounting Height"
      ],
      "max": [
        "Width / 2",
        0,
        "Mounting Height + Height"
      ],
      "material": "Material"
    },
    {
      "shape": "Box",
      "min": [
        "-Width / 2 + 2",
        "-Depth",
        "Mounting Height"
      ],
      "max": [
        "Width / 2 - 2",
        "-Depth + 20",
        "Mounting Height + Height"
      ],
      "material": "Material"
    }
  ],
  "plan": [
    {
      "shape": "Rectangle",
      "min": [
        "-Width / 2",
        "-Depth"
      ],
      "max": [
        "Width / 2",
        0
      ]
    },
    {
      "shape": "Line",
      "from": [
        "-Width / 2",
        "-Depth"
      ],
      "to": [
        "Width / 2",
        0
      ]
    },
    {
      "shape": "Line",
      "from": [
        "Width / 2",
        "-Depth"
      ],
      "to": [
        "-Width / 2",
        0
      ]
    }
  ]
